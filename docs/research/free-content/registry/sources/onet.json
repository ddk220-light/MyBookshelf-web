    {
      "document_id": "f1277973934e66ee1006136955e0ff90f7f5ed63acdd9dc16f1fa61728f4c7fe",
      "path": "docs/research/free-content/discovery/INDUSTRIES.md",
      "line": 15,
      "heading": "Group and tagging model",
      "text": "Use `industryIds`, source-supplied occupation codes/titles, `taskTerms`, content\nkind, language, jurisdiction, publication/version date and equipment/process\ncontext. Keep locally supplied occupation labels; do not automatically equate\ndifferent countries' qualifications. The [O*NET database](https://www.onetcenter.org/database.html)\nand its [documented API](https://services.onetcenter.org/reference/start/overview)\ncan supply US role/task vocabulary. India's [National Classification of\nOccupations](https://www.dge.gov.in/national_classification_of_occupations) supplies\nanother classification. Neither is a universal collection of practical manuals.",
      "status": "historical-context-needs-reconciliation"
    },
    {
      "document_id": "f1277973934e66ee1006136955e0ff90f7f5ed63acdd9dc16f1fa61728f4c7fe",
      "path": "docs/research/free-content/discovery/INDUSTRIES.md",
      "line": 142,
      "heading": "Category-specific acceptance and evidence",
      "text": "Before enablement, prove item-level topic/title retrieval and stable resolution,\nfree full-item access, source permissions and refresh behavior under the shared\nreview template. Neither an O*NET occupational match nor an NQR qualification\nmatch establishes that another provider has the requested manual. Identifier-only\nresolvers support discovery but do not count toward searchable-origin targets.",
      "status": "historical-context-needs-reconciliation"
    },
    {
      "document_id": "f1277973934e66ee1006136955e0ff90f7f5ed63acdd9dc16f1fa61728f4c7fe",
      "path": "docs/research/free-content/discovery/INDUSTRIES.md",
      "line": 150,
      "heading": "Documentation review limits",
      "text": "This review inspected primary web documentation/catalog pages, not production\nAPI requests or a hundred sources per industry. O*NET explicitly documents an\nAPI and downloadable data; reuse that as vocabulary evidence only until the\nchosen integration is tested. The NQR migration notice was observed directly.\nFDA/FAA/OSHA/NIST, ROSA P, FAO/WHO/IMO and Bharat Skills pages were readable.\nIndia's ICAR, MSME, FSSAI, NHM and CERT-In discovery links also appeared in official\nsearch results; catalog/permissions checks remain necessary.",
      "status": "historical-context-needs-reconciliation"
    }
  ]
