{"http": {"bytes_read": 2137, "content_type": "application/json", "final_url": "https://archive.org/metadata/MITRES10.S95F20/metadata/description", "redirect_location": null, "requested_at": "2026-11-05T13:56:11.026486+00:00", "response_headers": {}, "sampled_bytes_sha256": "101c549f369a57fd75d37858442ad37bdced428e3960505025997a8b03b614bd", "seconds": 1.082, "status": 200, "truncated": false, "url": "https://archive.org/metadata/MITRES10.S95F20/metadata/description"}, "job_id": "07b255589cc47caec994", "lead_ids": [], "observed_at": "2026-11-05T13:56:11.026366+00:00", "outcome": "captured", "public_document_links": ["https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"https:/ocw.mit.edu/RES-10-S95F20\\\"", "https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"https:/www.youtube.com/watch?v=2Y__Z_PgAxQ&list=PLUl4u3cNGP62-vPzt_GMdZRflJPjNdspG\\\"", "https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"https:/www.edx.org/course/physics-of-covid-19-transmission?utm_campaign=mitx&utm_medium=partner-marketing&utm_source=social&utm_content=10.s95x-ocw\\\"", "https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"https:/ocw.mit.edu/terms\\\"", "https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"https:/ocw.mit.edu\\\"", "https://archive.org/metadata/MITRES10.S95F20/metadata/\\\"http:/ow.ly/a1If50zVRlQ\\\""], "query_verified": false, "robots_evidence": {"bytes_read": 238, "content_type": "text/plain; charset=utf-8", "final_url": "https://archive.org/robots.txt", "redirect_location": null, "requested_at": "2026-11-05T13:56:07.170442+00:00", "response_headers": {}, "sampled_bytes_sha256": "83e00f46c71e9fa872694af73fa9c15a615b9052b2f10820a3d146bc506c6161", "seconds": 0.856, "status": 200, "truncated": false, "url": "https://archive.org/robots.txt"}, "source_ids": [], "text_excerpt": "{\"result\":\"\nInstructor: Martin Z. Bazant\nView the complete course:\nhttps://ocw.mit.edu/RES-10-S95F20\nYouTube Playlist:\nhttps://www.youtube.com/watch?v=2Y__Z_PgAxQ&list=PLUl4u3cNGP62-vPzt_GMdZRflJPjNdspG\nA collection of LightBoard lecture videos for 10.S95. Teaches scientific principles to quantitatively assess the risk of airborne transmission of COVID-19 in indoor spaces based on factors such as the occupancy, time, room geometry, mask use, ventilation, air filtration, humidity, respiratory activities, etc., as well as how these factors interact. This collection is suitable for learners with some undergraduate-level training in STEM, although some videos may also be accessible to the general public. Graduate students and professionals watch optional videos with more challenging mathematics.The full course with problems is available for free on edX:\\u00a0\nhttps://www.edx.org/course/physics-of-covid-19-transmission?utm_campaign=mitx&utm_medium=partner-marketing&utm_source=social&utm_content=10.s95x-ocw\nLicense: Creative Commons BY-NC-SA\nMore information at\nhttps://ocw.mit.edu/terms\nMore courses at\nhttps://ocw.mit.edu\nSupport OCW at\nhttp://ow.ly/a1If50zVRlQ\nWe encourage constructive comments and discussion on OCW\\u2019s YouTube and other social media channels. Personal attacks, hate speech, trolling, and inappropriate comments are not allowed and may be removed. More details at https://ocw.mit.edu/comments.\n\"}", "url": "https://archive.org/metadata/MITRES10.S95F20/metadata/description"}
