<style type="text/css">
/* Compact nested UberMenu categories on mobile */
@media (max-width: 959px) {

    /* Example: Animals > birds, Cats, Dogs, etc. */
    #ubermenu-main-2319
    .ubermenu-item-level-1 > .ubermenu-submenu {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        max-height: none !important;
    }

    #ubermenu-main-2319
    .ubermenu-item-level-1 > .ubermenu-submenu > .ubermenu-item {
        width: auto !important;
        max-width: none !important;
        float: none !important;
        clear: none !important;
    }

    #ubermenu-main-2319
    .ubermenu-item-level-1 > .ubermenu-submenu > .ubermenu-item > .ubermenu-target {
        width: 100% !important;
        box-sizing: border-box;
        padding: 9px 12px !important;
        line-height: 1.3 !important;
        white-space: normal !important;
        word-break: normal !important;
    }

    /* Keep UberMenu's Close button across the full row */
    #ubermenu-main-2319
    .ubermenu-item-level-1 > .ubermenu-submenu > .ubermenu-retractor-mobile {
        grid-column: 1 / -1;
        width: 100% !important;
        text-align: center;
    }
}</style>
