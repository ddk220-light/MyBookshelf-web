<script type="text/javascript">
(function () {

    function fixReadOnlineButtons() {
        document.querySelectorAll(
            '.book_description_footer a._df_link.df-popup-link'
        ).forEach(function (button) {
            button.classList.add('download-book');
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fixReadOnlineButtons);
    } else {
        fixReadOnlineButtons();
    }

    window.addEventListener('load', fixReadOnlineButtons);

})();</script>
<!-- end Simple Custom CSS and JS -->
