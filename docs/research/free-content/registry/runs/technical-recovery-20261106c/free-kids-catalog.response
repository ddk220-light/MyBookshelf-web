<style type="text/css">
/* =========================================================
   FREE KIDS BOOKS - HOMEPAGE MAINTENANCE CSS
   ========================================================= */


/* =========================================================
   1. HOMEPAGE KK STAR RATINGS
   ========================================================= */

.fkb-home-rating {
    display: block;
    clear: both;
    margin: 6px 0 10px;
}

.fkb-home-rating .kk-star-ratings {
    transform: scale(.72);
    transform-origin: left center;
    margin: 0 0 -7px !important;
}

.fkb-home-rating .kksr-legend {
    font-size: 13px !important;
}


/* =========================================================
   2. SIDEBAR / CATEGORIES
   ========================================================= */

.sidebar-top li h2 {
    font-size: 25px !important;
}

/* Keep Categories heading together */
#displaycategorieswidget-2 .widget-title,
#displaycategorieswidget-2 h2,
#displaycategorieswidget-2 h3 {
    white-space: nowrap !important;
}

/* Let long category names wrap only between words */
#displaycategorieswidget-2 ul.dcw > li > a {
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
    line-height: 1.25;
    text-align: center;
}


/* =========================================================
   3. READ ONLINE
   Style DearFlip immediately like the other green buttons
   ========================================================= */

.book_description_footer a._df_link.df-popup-link {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;

    text-align: center;
    color: #000 !important;
    text-decoration: none !important;
}

.book_description_footer a._df_link.df-popup-link:hover,
.book_description_footer a._df_link.df-popup-link:focus {
    color: #000 !important;
    text-decoration: none !important;
}


/* =========================================================
   4. HOMEPAGE BOOK AREA
   Container used for zoom/responsive button behaviour
   ========================================================= */

.home .book_description {
    container-type: inline-size;
}


/* =========================================================
   5. HOMEPAGE ACTION BUTTONS
   Desktop: always preserve 3 button positions
   ========================================================= */

.home .book_description_footer {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 10px !important;

    width: 100% !important;
    max-width: 100% !important;

    box-sizing: border-box;
    align-items: start;
}


/* Reset individual button wrappers */
.home .book_description_footer .common_width {
    width: 100% !important;
    min-width: 0 !important;
    max-width: none !important;

    margin: 0 !important;
    float: none !important;

    box-sizing: border-box;
    text-align: center;
}


/* Hard Copy = first position */
.home .book_description_footer
.common_width:not(.pdf-dwn):not(:has(> a._df_link)) {
    grid-column: 1;
}


/* Read Online = middle position */
.home .book_description_footer
.common_width:has(> a._df_link) {
    grid-column: 2;
}


/* Download PDF = third position */
.home .book_description_footer .pdf-dwn {
    grid-column: 3;
}


/* All buttons */
.home .book_description_footer .common_width > a {
    display: block !important;

    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;

    box-sizing: border-box !important;

    text-align: center;
    white-space: nowrap;

    font-size: clamp(14px, 1.2vw, 20px);
}


/* Views / Downloads labels */
.home .book_description_footer .common_width > div {
    display: block;

    width: 100% !important;
    max-width: 100% !important;

    box-sizing: border-box;

    text-align: center !important;
    white-space: nowrap;
}


/* =========================================================
   6. NARROW BOOK CONTENT AREA
   Browser zoom / tablet / narrower desktop
   ========================================================= */

@container (max-width: 720px) {

    .home .book_description_footer {
        gap: 6px !important;
    }

    .home .book_description_footer .common_width > a {
        font-size: 14px !important;
    }

    .home .book_description_footer .common_width > div {
        font-size: 14px !important;
    }
}


/* =========================================================
   7. VERY NARROW BOOK CONTENT
   Switch cleanly to 2 columns
   ========================================================= */

@container (max-width: 580px) {

    .home .book_description_footer {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px !important;
    }

    /*
     * At this width stop forcing Hard Copy / Read / Download
     * into desktop column positions.
     * They simply flow in their natural HTML order.
     */
    .home .book_description_footer .common_width,
    .home .book_description_footer
    .common_width:not(.pdf-dwn):not(:has(> a._df_link)),
    .home .book_description_footer
    .common_width:has(> a._df_link),
    .home .book_description_footer .pdf-dwn {
        grid-column: auto !important;
    }

    .home .book_description_footer .common_width > a {
        font-size: 14px !important;
    }
}


/* =========================================================
   8. SMALL PHONE
   One action per row
   ========================================================= */

@container (max-width: 380px) {

    .home .book_description_footer {
        grid-template-columns: 1fr;
        gap: 8px !important;
    }

    .home .book_description_footer .common_width {
        grid-column: auto !important;
    }
}


/* =========================================================
   9. GENERAL MOBILE TUNING
   ========================================================= */

@media (max-width: 767px) {

    .home .book_description_footer .common_width > a {
        white-space: nowrap;
    }

    .sidebar-top li h2 {
        font-size: 22px !important;
    }
}</style>
<!-- end Simple Custom CSS and JS -->
