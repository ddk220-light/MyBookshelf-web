<style type="text/css">
/* Categories responsive layout */
@media (max-width: 991px) {

    .sidebar-top-content {
        width: 100% !important;
        float: none !important;
        clear: both;
        padding-left: 15px;
        padding-right: 15px;
    }

    #displaycategorieswidget-2 {
        width: 100% !important;
    }

    #displaycategorieswidget-2 ul.dcw {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px 10px;
        width: 100% !important;
        padding: 0;
        margin: 0;
    }

    #displaycategorieswidget-2 ul.dcw > li {
        width: 100% !important;
        float: none !important;
        margin: 0 !important;
    }

    #displaycategorieswidget-2 ul.dcw > li > a {
        display: block;
        width: 100% !important;
        box-sizing: border-box;
        white-space: normal;
        word-break: normal;
        text-align: center;
        padding-left: 6px;
        padding-right: 6px;
    }
}</style>
