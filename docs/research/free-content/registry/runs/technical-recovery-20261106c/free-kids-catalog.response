    display: block;
}

.fkb-home-rating .kk-star-ratings {
    display: inline-flex;
    align-items: center;
    transform: scale(.82);
    transform-origin: left center;
}

.fkb-home-rating .kksr-legend {
    font-size: 12px !important;
}</style>
