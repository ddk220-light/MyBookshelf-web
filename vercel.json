{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "ignoreCommand": "node ../tools/deployment/ignore-web-build.mjs",
      "routes": [
        {
          "src": "/(.*)",
          "headers": {
            "Cache-Control": "no-cache",
            "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://books.google.com https://books.googleusercontent.com https://covers.openlibrary.org https://archive.org/download/ https://*.us.archive.org/view_archive.php https://tile.openstreetmap.org data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
          },
          "continue": true
        },
        {
          "src": "/assets/(.*)",
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "src": "/textures/(.*)",
          "headers": {
            "Cache-Control": "public, max-age=604800"
          },
          "continue": true
        },
        {
          "src": "/app(?:/.*)?",
          "headers": {
            "X-Robots-Tag": "noindex, follow"
          },
          "continue": true
        },
        {
          "src": "/select(?:/.*)?",
          "headers": {
            "X-Robots-Tag": "noindex, follow"
          },
          "continue": true
        },
        {
          "src": "/fonts/(.*)",
          "headers": {
            "Cache-Control": "public, max-age=604800"
          },
          "continue": true
        },
        {
          "src": "/app(?:/.*)?",
          "dest": "/app/index.html"
        },
        {
          "src": "/select(?:/.*)?",
          "dest": "/app/index.html"
        },
        {
          "src": "/(about|how-it-works|open-source|privacy|support|libraries)",
          "dest": "/$1.html"
        },
        {
          "src": "/libraries/([^/]+)",
          "dest": "/libraries/$1.html"
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "/(.*)",
          "dest": "/404.html",
          "status": 404
        }
      ]
    },
    "api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "vercel.js",
      "ignoreCommand": "node ../tools/deployment/ignore-web-build.mjs",
      "functions": {
        "vercel.js": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mybookshelf.cloud"
        }
      ],
      "destination": "https://mybookshelf.cloud/:path*",
      "permanent": true
    }
  ]
}
