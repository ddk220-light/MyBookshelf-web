{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "ignoreCommand": "node ../tools/deployment/ignore-web-build.mjs",
      "rewrites": [
        {
          "source": "/app",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/(.*)",
          "destination": "/app/index.html"
        },
        {
          "source": "/select/(.*)",
          "destination": "/app/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://books.google.com https://books.googleusercontent.com https://covers.openlibrary.org https://archive.org/download/ https://*.us.archive.org/view_archive.php https://tile.openstreetmap.org data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/textures/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "/app/:path*",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, follow"
            }
          ]
        },
        {
          "source": "/select/:path*",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, follow"
            }
          ]
        },
        {
          "source": "/fonts/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ],
      "cleanUrls": true
    },
    "api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "vercel.js",
      "ignoreCommand": "node ../tools/deployment/ignore-web-build.mjs",
      "functions": {
        "vercel.js": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mybookshelf.cloud"
        }
      ],
      "destination": "https://mybookshelf.cloud/:path*",
      "permanent": true
    }
  ]
}
