{
  "openapi": "3.1.0",
  "info": {
    "title": "MyBookshelf Library Connector API",
    "version": "1.0.0",
    "description": "Internal HTTP-only connector API. Not deployed publicly. Native fidelity and source observation times are explicit."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4321/api/catalog/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": ["string", "null"]
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["libraryId", "query"],
        "properties": {
          "libraryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "connectionId": {
            "type": "string"
          },
          "field": {
            "enum": ["keyword", "title"]
          },
          "filters": {
            "type": "object",
            "maxProperties": 0
          },
          "sort": {
            "const": "website_default"
          },
          "pageSize": {
            "const": "website_default"
          },
          "cursor": {
            "type": ["string", "null"],
            "maxLength": 4096
          },
          "semantics": {
            "const": "website_native"
          },
          "freshness": {
            "const": "live"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "requestId",
          "schemaVersion",
          "libraryId",
          "connectionId",
          "requestedProfile",
          "effectiveProfile",
          "records",
          "page",
          "total",
          "freshness",
          "fidelity",
          "usage",
          "evidence"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "schemaVersion": {
            "const": 1
          },
          "libraryId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "requestedProfile": {
            "type": "object"
          },
          "effectiveProfile": {
            "type": "object"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["recordId", "title", "recordRef", "nativeRank"],
              "properties": {
                "recordId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "recordRef": {
                  "type": "string"
                },
                "nativeRank": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "page": {
            "type": "object",
            "required": ["returned", "hasMore", "complete", "nextCursor"],
            "properties": {
              "returned": {
                "type": "integer",
                "minimum": 0
              },
              "hasMore": {
                "type": ["boolean", "null"]
              },
              "complete": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": ["string", "null"]
              }
            }
          },
          "total": {
            "type": "object"
          },
          "freshness": {
            "type": "object"
          },
          "fidelity": {
            "enum": ["website_equivalent", "unverified"]
          },
          "usage": {
            "type": "object"
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    }
  },
  "paths": {
    "/libraries": {
      "get": {
        "summary": "List libraries",
        "operationId": "list_libraries",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        }
      }
    },
    "/libraries/{id}/capabilities": {
      "get": {
        "summary": "Get connection capabilities",
        "operationId": "get_connection_capabilities",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/libraries/{id}/health": {
      "get": {
        "summary": "Read saved health",
        "operationId": "read_saved_health",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/search": {
      "post": {
        "summary": "Search one native catalog",
        "operationId": "search_one_native_catalog",
        "responses": {
          "200": {
            "description": "Operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        }
      }
    },
    "/records/resolve": {
      "post": {
        "summary": "Resolve a signed record reference",
        "operationId": "resolve_a_signed_record_reference",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recordRef"],
                "properties": {
                  "recordRef": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/audit-runs": {
      "post": {
        "summary": "Start operator audit",
        "operationId": "start_operator_audit",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          },
          "202": {
            "description": "Accepted asynchronous run"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mode", "libraryIds"],
                "properties": {
                  "mode": {
                    "enum": ["qualify", "health"]
                  },
                  "libraryIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/audit-runs/{id}": {
      "get": {
        "summary": "Read audit progress",
        "operationId": "read_audit_progress",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/audit-runs/{id}/report": {
      "get": {
        "summary": "Read an existing report",
        "operationId": "read_an_existing_report",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/audit-runs/{id}/cancel": {
      "post": {
        "summary": "Cancel active audit",
        "operationId": "cancel_active_audit",
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or incorrect API key"
          },
          "422": {
            "description": "Unsupported source profile"
          },
          "502": {
            "description": "Catalog operation failed"
          },
          "202": {
            "description": "Cancellation requested"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
