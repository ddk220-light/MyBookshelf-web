# Optional catalog credentials, read by the server only.
# Copy to .env for local development and fill values privately.
GOOGLE_BOOKS_API_KEY=
CALIL_APP_KEY=
OPENALEX_API_KEY=

# Optional public free-content discovery; no reader accounts required.
CONTENT_DISCOVERY_ENABLED=false
VITE_CONTENT_DISCOVERY_ENABLED=false
CONTENT_CURSOR_SECRET=
CONTENT_KNOWLEDGE_ENABLED=false
CONTENT_EUROPEPMC_ENABLED=false
CONTENT_OPENALEX_ENABLED=false
# One provider per request; All knowledge coordinates bounded requests in the browser. Runtime verifies OpenAlex free funds and pricing.
# No Redis/database or application-wide daily/minute counters are required.
# Reviewed English/Hindi/Tamil StoryWeaver records; free source account required.
CONTENT_CHILDREN_ENABLED=false
VITE_CHILDREN_PILOT_ENABLED=false

# Account service (server only). Disabled until explicitly configured.
ACCOUNTS_ENABLED=false
ACCOUNTS_ENVIRONMENT=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ACCOUNTS_AUTH_DATABASE_URL=
# Separate reading and migration credentials; never use the migration role at runtime.
ACCOUNTS_READING_DATABASE_URL=
ACCOUNTS_MIGRATION_DATABASE_URL=
# Disposable database only; integration tests refuse to operate without this opt-in.
ACCOUNT_TEST_DATABASE_URL=
# Transactional mail / durable worker (server only).
RESEND_API_KEY=
ACCOUNTS_MAIL_FROM=
ACCOUNTS_JOB_SECRET=
ACCOUNTS_WORKER_DATABASE_URL=
ACCOUNTS_CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
ACCOUNTS_DELETION_LEDGER_READ_WRITE_TOKEN=
