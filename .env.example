# Optional catalog credentials, read by the server only.
# Copy to .env for local development and fill values privately.
GOOGLE_BOOKS_API_KEY=
CALIL_APP_KEY=

# Optional public free-content discovery; no reader accounts required.
CONTENT_DISCOVERY_ENABLED=false
CONTENT_CURSOR_SECRET=
CONTENT_EUROPEPMC_ENABLED=false
CONTENT_EUROPEPMC_DAILY_LIMIT=
CONTENT_EUROPEPMC_PER_MINUTE=
CONTENT_REDIS_REST_URL=
CONTENT_REDIS_REST_TOKEN=
