# Optional catalog credentials, read by the server only.
# Copy to .env for local development and fill values privately.
GOOGLE_BOOKS_API_KEY=
CALIL_APP_KEY=

# Account service (server only). Disabled until explicitly configured.
ACCOUNTS_ENABLED=false
ACCOUNTS_ENVIRONMENT=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ACCOUNTS_AUTH_DATABASE_URL=
# Separate reading and migration credentials; never use the migration role at runtime.
ACCOUNTS_READING_DATABASE_URL=
ACCOUNTS_MIGRATION_DATABASE_URL=
# Disposable database only; integration tests refuse to operate without this opt-in.
ACCOUNT_TEST_DATABASE_URL=
# Transactional mail / durable worker (server only).
RESEND_API_KEY=
ACCOUNTS_MAIL_FROM=
ACCOUNTS_JOB_SECRET=
ACCOUNTS_WORKER_DATABASE_URL=
ACCOUNTS_CRON_SECRET=
