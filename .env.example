# Optional catalog credentials, read by the server only.
# Copy to .env for local development and fill values privately.
GOOGLE_BOOKS_API_KEY=
CALIL_APP_KEY=
OPENALEX_API_KEY=

# One-shelf redesign (client, build time). Off in production until release;
# set it to true for Vercel Preview only. Vite reads VITE_* from the shell or client/.env*.
VITE_ONE_SHELF=false

# Optional public free-content discovery; no reader accounts required.
CONTENT_DISCOVERY_ENABLED=false
VITE_CONTENT_DISCOVERY_ENABLED=false
CONTENT_CURSOR_SECRET=
CONTENT_KNOWLEDGE_ENABLED=false
CONTENT_EUROPEPMC_ENABLED=false
CONTENT_OPENALEX_ENABLED=false
# One provider per request; All knowledge coordinates bounded requests in the browser. Runtime verifies OpenAlex free funds and pricing.
# No Redis/database or application-wide daily/minute counters are required.
# Reviewed English/Hindi/Tamil StoryWeaver records; free source account required.
CONTENT_CHILDREN_ENABLED=false
VITE_CHILDREN_PILOT_ENABLED=false

# Account service (server only). Disabled until explicitly configured.
ACCOUNTS_ENABLED=false
ACCOUNTS_ENVIRONMENT=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ACCOUNTS_AUTH_DATABASE_URL=
# Separate reading and migration credentials; never use the migration role at runtime.
ACCOUNTS_READING_DATABASE_URL=
ACCOUNTS_MIGRATION_DATABASE_URL=
# Disposable database only; integration tests refuse to operate without this opt-in.
ACCOUNT_TEST_DATABASE_URL=
# Transactional mail / durable worker (server only).
RESEND_API_KEY=
ACCOUNTS_MAIL_FROM=
ACCOUNTS_JOB_SECRET=
ACCOUNTS_WORKER_DATABASE_URL=
ACCOUNTS_CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
ACCOUNTS_DELETION_LEDGER_READ_WRITE_TOKEN=

# Catalog lookup layer (server only): platforms that /availability checks through
# the new layer, as a comma list or `all`. Empty keeps the old path.
CATALOG_LOOKUP_V2=

# Catalog store (server only): stored library answers, library health, the
# anonymous log and library requests/problem reports. A separate database from
# accounts. Without CATALOG_STORE_ENABLED=true and CATALOG_DATABASE_URL the API
# still works: answers and health stay in memory per instance, the log is
# dropped and submissions are held in memory.
CATALOG_STORE_ENABLED=false
# Runtime role (catalog_runtime), pooled connection string.
CATALOG_DATABASE_URL=
# Daily maintenance job (catalog_worker).
CATALOG_WORKER_DATABASE_URL=
# Owner role for `npm run catalog:migrate --workspace=server`; operator machine only, never deployed.
CATALOG_MIGRATION_DATABASE_URL=
# HMAC key (32+ characters) for anonymous submission limits; never a raw IP.
CATALOG_BUCKET_SECRET=
# Anonymous operational log (search text, no account, IP or device). Keep off
# until the new privacy text is published.
USAGE_LOG_ENABLED=false
# Kill switch for result marking (/holdings/search); false replies with every book unchecked.
HOLDINGS_BACKGROUND_ENABLED=true
# Bearer secret Vercel Cron sends to /api/internal/catalog-maintenance (32+ characters).
CRON_SECRET=
# Disposable local *_test database only; catalog integration tests skip without it.
CATALOG_TEST_DATABASE_URL=
